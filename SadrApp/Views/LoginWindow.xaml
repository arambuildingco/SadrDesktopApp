<Window x:Class="SadrApp.Views.LoginWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سامانه صدر" Height="470" Width="420"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
  <Border CornerRadius="14" Background="{DynamicResource PageBgBrush}" BorderBrush="#D9E1EF" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.35" Direction="270"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Border Grid.Row="0" Background="#1F3A5F" CornerRadius="14,14,0,0" Padding="18,14"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="🔐" FontSize="22" Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="سامانه حسابداری و مدیریت پروژه — صدر" Foreground="White" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="برای ورود، نام کاربری و رمز عبور خود را وارد کنید" Foreground="#A9BFEA" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- body -->
      <StackPanel Grid.Row="1" Margin="26,20,26,20">
        <TextBlock Text="🏭" FontSize="42" HorizontalAlignment="Center" Margin="0,4,0,10"/>

        <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtUsername" Style="{StaticResource Input}" FontSize="14" Padding="10,8"/>

        <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}"/>
        <Grid>
          <!-- LTR: WPF's PasswordBox reverses character order under RTL flow direction,
               which would both display and store the password backwards. -->
          <PasswordBox x:Name="TxtPassword" FlowDirection="LeftToRight" FontSize="14" Padding="10,8"
                       Background="White" BorderBrush="#C3D2F4" BorderThickness="1"/>
          <TextBox x:Name="TxtReveal" FlowDirection="LeftToRight" FontSize="14" Padding="10,8" Visibility="Collapsed"
                   Background="White" BorderBrush="#C3D2F4" BorderThickness="1"/>
        </Grid>

        <CheckBox x:Name="ChkShow" Content="نمایش رمز عبور" Margin="0,8,0,0" FontSize="12"
                  Foreground="#44506B" Checked="ChkShow_Changed" Unchecked="ChkShow_Changed"/>

        <Button x:Name="BtnLogin" Content="ورود" Style="{StaticResource PrimaryBtn}"
                FontSize="14" MinWidth="120" Height="36" Margin="0,14,0,0" IsDefault="True"/>

        <Button x:Name="BtnExit" Content="خروج" Style="{StaticResource GhostBtn}"
                MinWidth="90" Height="30" Margin="0,8,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="#D9534F" FontSize="12" TextWrapping="Wrap"
                   Margin="0,10,0,0" HorizontalAlignment="Center" Text=" "/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
