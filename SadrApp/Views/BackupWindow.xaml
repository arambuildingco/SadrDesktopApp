<Window x:Class="SadrApp.Views.BackupWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پشتیبان‌گیری و بازیابی بانک اطلاعاتی" Height="440" Width="680"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="پشتیبان‌گیری و بازیابی بانک اطلاعاتی" Style="{StaticResource H1}" Margin="0,0,0,10"/>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="ذخیره نسخه پشتیبان" FontWeight="Bold" Foreground="#2B3660" Margin="0,0,0,6"/>
        <TextBlock Text="یک نسخه کامل (Bak) از بانک اطلاعاتی جاری می‌سازد؛ نام پیشنهادی شامل تاریخ و ساعت است." Foreground="#5A6478" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnBackup" Content="💾 تهیه نسخه پشتیبان" Style="{StaticResource PrimaryBtn}"/>
          <Button x:Name="BtnOpenFolder" Content="📁 بازکردن محل ذخیره" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
        </StackPanel>

        <Separator Margin="0,10"/>

        <TextBlock Text="بازیابی از فایل پشتیبان" FontWeight="Bold" Foreground="#2B3660" Margin="0,0,0,6"/>
        <TextBlock Text="بازیابی همه اطلاعات را با محتوای فایل پشتیبان جایگزین می‌کند؛ این عمل بازگشت‌پذیر نیست." Foreground="#A33" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnRestore" Content="♻️ بازیابی از فایل..." Style="{StaticResource DangerBtn}"/>
        </StackPanel>

        <Separator Margin="0,10"/>

        <TextBlock Text="محل ذخیره:" Foreground="#5A6478"/>
        <TextBox x:Name="TxtFolder" IsReadOnly="True" Style="{StaticResource Input}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
      <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
               Background="Transparent" BorderThickness="0"/>
    </Border>
  </Grid>
</Window>
