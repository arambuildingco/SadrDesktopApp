<Window x:Class="SadrApp.Views.Controls.InvoiceEditorWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SadrApp.Views.Controls"
        Title="فاکتور" Height="760" Width="1150" MinHeight="640" MinWidth="980"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="HeaderTitle" Text="فاکتور جدید" Style="{StaticResource H1}" Margin="0,0,10,0"/>
          <ComboBox x:Name="CmbType" Width="170" Style="{StaticResource Combo}"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="تاریخ فاکتور" Style="{StaticResource FieldLabel}" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <controls:PersianDatePicker x:Name="DpDate" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>
          <TextBlock Text="شماره فاکتور" Style="{StaticResource FieldLabel}" Grid.Row="0" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtNumber" Style="{StaticResource Input}" Grid.Row="0" Grid.Column="3"/>
          <TextBlock Text="وضعیت" Style="{StaticResource FieldLabel}" Grid.Row="0" Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <ComboBox x:Name="CmbStatus" Width="150" Style="{StaticResource Combo}" Grid.Row="0" Grid.Column="5" HorizontalAlignment="Left"/>

          <TextBlock x:Name="LblParty" Text="مشتری" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center"/>
          <ComboBox x:Name="CmbParty" Grid.Row="1" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,8,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="کد" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="2" Margin="0,8,8,0" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtCode" Style="{StaticResource Input}" Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"/>
          <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="4" Margin="0,8,8,0" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtDescription" Style="{StaticResource Input}" Grid.Row="1" Grid.Column="5" Margin="0,8,0,0"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- line items -->
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnAddRow" Content="➕ افزودن کالا" Style="{StaticResource PrimaryBtn}"/>
        <Button x:Name="BtnRemoveRow" Content="🗑 حذف ردیف" Style="{StaticResource DangerBtn}" Margin="8,0,0,0"/>
        <TextBlock x:Name="HintText" Text="برای انتخاب کالا روی ستون «کالا» دوبار کلیک کنید؛ برای مقادیر روی ستون‌های دیگر دوبار کلیک کنید" Foreground="#8A94A8"
                   FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="#D9534F" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="Transparent" BorderThickness="0" RowHeight="34" FontSize="13"
                BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="42"/>
          <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="2*"/>
          <DataGridTextColumn Header="واحد" Binding="{Binding UnitName}" IsReadOnly="True" Width="90"/>
          <DataGridTextColumn Header="مقدار" Binding="{Binding AmountText}" Width="90"/>
          <DataGridTextColumn Header="قیمت واحد" Binding="{Binding PriceText}" Width="110"/>
          <DataGridTextColumn Header="ارز" Binding="{Binding CurrencyName}" IsReadOnly="True" Width="80"/>
          <DataGridTextColumn Header="اضافه ٪" Binding="{Binding ExtraText}" Width="70"/>
          <DataGridTextColumn Header="تخفیف ٪" Binding="{Binding DiscountText}" Width="70"/>
          <DataGridTextColumn Header="تخفیف مبلغ" Binding="{Binding DiscAmtText}" Width="100"/>
          <DataGridTextColumn Header="جمع ردیف" Binding="{Binding TotalText}" IsReadOnly="True" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- totals -->
    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock x:Name="TxtTotalDiscount" Style="{StaticResource H2}" Margin="0,0,30,0" Text="تخفیف کل: 0"/>
        <TextBlock x:Name="TxtTotal" Style="{StaticResource H2}" Text="جمع کل: 0"/>
      </StackPanel>
    </Border>

    <!-- buttons -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button x:Name="BtnSave" Content="💾 ذخیره فاکتور" Style="{StaticResource PrimaryBtn}" MinWidth="130"/>
      <Button x:Name="BtnMoney" Content="💰 تراکنش‌های مالی" Style="{StaticResource GhostBtn}" MinWidth="130" Margin="8,0,0,0"
              Visibility="Hidden" ToolTip="دریافت/پرداخت‌های این فاکتور (چند تراکنش مجاز است)"/>
      <Button x:Name="BtnCancel" Content="انصراف" Style="{StaticResource GhostBtn}" MinWidth="100" Margin="8,0,0,0" IsCancel="True"/>
      <Button x:Name="BtnPrint" Content="🖨 چاپ / PDF" Style="{StaticResource GhostBtn}" MinWidth="120" Margin="24,0,0,0"
              Visibility="Hidden" ToolTip="چاپ یا ذخیره PDF فاکتور ذخیره‌شده"/>
    </StackPanel>
  </Grid>
</Window>
