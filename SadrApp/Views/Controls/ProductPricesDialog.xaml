<Window x:Class="SadrApp.Views.Controls.ProductPricesDialog"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قیمت‌گذاری کالا" Height="540" Width="800"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeaderTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnAdd" Content="➕ قیمت جدید" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnEdit" Content="✏️ ویرایش" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnDelete" Content="🗑 حذف" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnReload" Content="🔄 بازخوانی" Style="{StaticResource GhostBtn}"/>
        <TextBlock Text="قیمت‌ها به ترتیب تاریخ ثبت؛ آخرین قیمت به‌عنوان پیش‌فرض فاکتور استفاده می‌شود" VerticalAlignment="Center"
                   Foreground="#8A94A8" FontSize="11" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                BorderThickness="0" RowHeight="34" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="مبلغ" Binding="{Binding Code}" Width="160"/>
          <DataGridTextColumn Header="واحد پول" Binding="{Binding Extra}" Width="120"/>
          <DataGridTextColumn Header="تخفیف پیش‌فرض ٪" Binding="{Binding Extra2}" Width="140"/>
          <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding Title}" Width="120"/>
          <DataGridTextColumn Header="تاریخ پایان" Binding="{Binding Description}" Width="120"/>
          <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="80"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
