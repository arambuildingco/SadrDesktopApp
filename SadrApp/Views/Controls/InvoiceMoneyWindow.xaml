<Window x:Class="SadrApp.Views.Controls.InvoiceMoneyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تراکنش‌های مالی فاکتور" Height="480" Width="760"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock x:Name="TxtTitle" Style="{StaticResource H2}" Margin="0,0,0,2"/>
      <TextBlock x:Name="TxtTotals" Style="{StaticResource FieldLabel}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="BtnNew" Content="➕ ثبت دریافت/پرداخت" Style="{StaticResource PrimaryBtn}"/>
      <Button x:Name="BtnDelete" Content="🗑 حذف" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
      <TextBlock x:Name="TxtBalance" VerticalAlignment="Center" Margin="20,0,0,0" Style="{StaticResource H2}"/>
    </StackPanel>

    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="6">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="Transparent" BorderThickness="0" RowHeight="32" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="110"/>
          <DataGridTextColumn Header="نوع" Binding="{Binding Kind}" Width="90"/>
          <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount}" Width="140"/>
          <DataGridTextColumn Header="صندوق/حساب" Binding="{Binding Target}" Width="*"/>
          <DataGridTextColumn Header="طرف حساب" Binding="{Binding Person}" Width="*"/>
          <DataGridTextColumn Header="توضیح" Binding="{Binding Description}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Button x:Name="BtnClose" Grid.Row="3" Content="بستن" Style="{StaticResource GhostBtn}" MinWidth="100"
            Margin="0,10,0,0" HorizontalAlignment="Left"/>
  </Grid>
</Window>
