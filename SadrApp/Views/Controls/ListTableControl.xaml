<UserControl x:Class="SadrApp.Views.Controls.ListTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="BtnNew" Content="➕ جدید" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnEdit" Content="✏️ ویرایش" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnDelete" Content="🗑 حذف" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnRefresh" Content="🔄 بازخوانی" Style="{StaticResource GhostBtn}"/>
          <Button x:Name="BtnPrint" Content="🖨 چاپ" Style="{StaticResource GhostBtn}" Margin="12,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock Text="جستجو:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#44506B"/>
          <TextBox x:Name="SearchBox" Width="220" Style="{StaticResource Input}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4">
      <DataGrid x:Name="Grid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                Background="Transparent"
                BorderThickness="0"
                RowHeight="34"
                FontSize="13"
                EnableRowVirtualization="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="60"/>
          <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="110"/>
          <DataGridTextColumn x:Name="ExtraColumn" Header="توضیحات اضافی" Binding="{Binding Extra}" Width="180" Visibility="Collapsed"/>
          <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="2*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
