<Window x:Class="SadrApp.Views.Controls.ProductImagesWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تصاویر کالا" Height="640" Width="980"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeaderTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10"/>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnAdd" Content="➕ افزودن تصویر" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnDelete" Content="🗑 حذف تصویر" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnReload" Content="🔄 بازخوانی" Style="{StaticResource GhostBtn}"/>
        <TextBlock Text="برای افزودن، یک یا چند تصویر را انتخاب کنید؛ فایل‌ها در پوشه برنامه ذخیره می‌شوند"
                   VerticalAlignment="Center" Foreground="#8A94A8" FontSize="11" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="6">
        <Grid>
          <ListBox x:Name="ImagesList" BorderThickness="0" Background="Transparent"
                   SelectionMode="Single" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="6">
                  <Border Width="150" Height="150" CornerRadius="6" Background="#F2F5FA"
                          BorderBrush="#E1E6EF" BorderThickness="1">
                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="6"/>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis" Width="150"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyHint" Text="برای این کالا تصویری ثبت نشده است."
                     Foreground="#8A94A8" FontSize="13" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Margin="10,0,0,0">
        <StackPanel>
          <TextBlock Text="پیش‌نمایش" FontWeight="Bold" Margin="0,0,0,8"/>
          <Border Background="#F7F9FC" CornerRadius="6" Height="300">
            <Image x:Name="Preview" Stretch="Uniform" Margin="8"/>
          </Border>
          <TextBlock x:Name="PreviewName" TextWrapping="Wrap" FontWeight="Bold"
                     FontSize="12" Margin="0,10,0,0"/>
          <TextBlock x:Name="PreviewInfo" Foreground="#8A94A8" FontSize="11" Margin="0,4,0,0"/>
          <TextBlock x:Name="PreviewPath" Foreground="#8A94A8" FontSize="10" TextWrapping="Wrap"
                     Margin="0,6,0,0" FlowDirection="LeftToLeft"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
