<Window x:Class="SadrApp.Views.Controls.TaskReportsWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گزارش‌های وظیفه" Height="520" Width="760"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TaskTitle" Grid.Row="0" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,0,4"/>
    <TextBlock x:Name="TaskMeta" Grid.Row="1" FontSize="12" Foreground="#6A7690" Margin="0,0,0,8"/>

    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="6">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="Transparent" BorderThickness="0" RowHeight="32" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
          <DataGridTextColumn Header="تاریخ گزارش" Binding="{Binding DateText}" Width="110"/>
          <DataGridTextColumn Header="گزارش‌دهنده" Binding="{Binding Reporter}" Width="140"/>
          <DataGridTextColumn Header="شرح گزارش" Binding="{Binding Description}" Width="*"/>
          <DataGridTextColumn Header="هزینه (ريال)" Binding="{Binding Cost, StringFormat=N0}" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
      <Button x:Name="BtnNew" Content="➕ گزارش جدید" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
      <Button x:Name="BtnEdit" Content="✏️ ویرایش" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
      <Button x:Name="BtnDelete" Content="🗑 حذف" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"/>
      <Button x:Name="BtnClose" Content="بستن" Style="{StaticResource GhostBtn}" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
