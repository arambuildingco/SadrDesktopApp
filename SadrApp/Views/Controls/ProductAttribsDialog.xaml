<Window x:Class="SadrApp.Views.Controls.ProductAttribsDialog"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویژگی‌های کالا" Height="520" Width="760"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeaderTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnAddExtra" Content="➕ ویژگی تکمیلی" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" ToolTip="ویژگی مستقل از دسته‌های این کالا"/>
        <Button x:Name="BtnEdit" Content="✏️ ثبت/ویرایش مقدار" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnDelete" Content="🗑 حذف مقدار" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnReload" Content="🔄 بازخوانی" Style="{StaticResource GhostBtn}"/>
        <TextBlock Text="روی ردیف دوبار کلیک کنید تا مقدار ثبت شود" VerticalAlignment="Center"
                   Foreground="#8A94A8" FontSize="11" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                BorderThickness="0" RowHeight="34" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ویژگی" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="از دسته" Binding="{Binding Code}" Width="150"/>
          <DataGridTextColumn Header="الزامی" Binding="{Binding Extra}" Width="80"/>
          <DataGridTextColumn Header="مقدار" Binding="{Binding Description}" Width="2*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
