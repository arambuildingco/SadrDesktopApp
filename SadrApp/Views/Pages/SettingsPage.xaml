<UserControl x:Class="SadrApp.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource PageBgBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Margin="16,16,16,24" HorizontalAlignment="Right">

      <TextBlock Text="تنظیمات برنامه" Style="{StaticResource H1}"/>
      <TextBlock Text="نام فروشنده و لوگو روی فاکتورهای چاپی استفاده می‌شوند؛ پوستهٔ رنگی کل برنامه را عوض می‌کند."
                 Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>

      <!-- ===== invoice / seller ===== -->
      <Border Style="{StaticResource SectionCard}" Margin="0,8,0,12">
        <StackPanel>
          <TextBlock Text="🧾 فاکتور و فروشنده" Style="{StaticResource H2}" Margin="0,0,0,8"/>
          <TextBlock Text="نام فروشنده:" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TblSellerName" Style="{StaticResource Input}" MaxLength="100"
                   ToolTip="روی فاکتور چاپی جای «صدر» می‌نشیند؛ خالی = بدون تغییر"/>
          <TextBlock Text="در پایین فاکتور چاپ می‌شود (صادر شده توسط …) و وقتی شرکت ثبت‌شده‌ای وجود ندارد نام سربرگ فاکتور است."
                     Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"/>

          <TextBlock Text="لوگوی فاکتور:" Style="{StaticResource FieldLabel}"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Border Background="White" BorderBrush="{DynamicResource BorderBrushResource}" BorderThickness="1"
                    CornerRadius="6" Width="120" Height="88" Padding="4">
              <Image x:Name="LogoPreview" Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <Button x:Name="BtnPickLogo" Content="📁 انتخاب تصویر…" Style="{StaticResource GhostBtn}" Margin="0,0,0,6"/>
              <Button x:Name="BtnClearLogo" Content="✖ حذف لوگو" Style="{StaticResource GhostBtn}" Margin="0,0,0,6"/>
              <TextBlock Text="PNG یا JPG، حداکثر ۲MB — وقتی چیدمان چاپ لوگوی خودش را نداشته باشد این تصویر چاپ می‌شود."
                         Foreground="{DynamicResource MutedBrush}" FontSize="10.5" MaxWidth="360" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnSave" Content="💾 ذخیره" Style="{StaticResource PrimaryBtn}" MinWidth="110"/>
            <TextBlock x:Name="TxtSavedStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ===== color schema ===== -->
      <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="🎨 پوستهٔ رنگی" Style="{StaticResource H2}" Margin="0,0,0,2"/>
          <TextBlock Text="با کلیک روی هر پوسته، رنگ‌های کل برنامه فوراً عوض می‌شوند و انتخاب شما ذخیره می‌شود."
                     Style="{StaticResource FieldLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>
          <WrapPanel x:Name="ThemePanel"/>
        </StackPanel>
      </Border>

      <!-- ===== shortcuts ===== -->
      <Border Style="{StaticResource SectionCard}">
        <StackPanel>
          <TextBlock Text="پنجره‌های تنظیم دیگر" Style="{StaticResource H2}" Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnPrintSettings" Content="🖨 تنظیمات چاپ فاکتور" Style="{StaticResource GhostBtn}" Margin="0,0,8,0"/>
            <Button x:Name="BtnFontSettings" Content="🔤 تنظیمات فونت" Style="{StaticResource GhostBtn}"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
