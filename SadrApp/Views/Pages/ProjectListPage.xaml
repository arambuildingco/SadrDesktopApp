<UserControl x:Class="SadrApp.Views.Pages.ProjectListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SadrApp.ViewModels">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10"/>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="BtnNew" Content="➕ پروژه جدید" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnAddChild" Content="↳ زیرپروژه" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnEdit" Content="✏️ ویرایش" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnTasks" Content="📋 وظایف" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnDelete" Content="🗑 حذف" Style="{StaticResource DangerBtn}" Margin="0,0,6,0"/>
          <Button x:Name="BtnReload" Content="🔄 بازخوانی" Style="{StaticResource GhostBtn}"/>
        </StackPanel>

        <TreeView x:Name="Tree" Grid.Row="1"
                  FontSize="13"
                  BorderThickness="0"
                  Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="True">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="True"/>
              <Setter Property="Padding" Value="4,3"/>
              <Setter Property="Foreground" Value="#22314F"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type vm:ProjectNode}"
                                      ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📈" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Code, StringFormat='  ({0})'}" Foreground="#8A94A8"/>
                <TextBlock Text="{Binding Summary}" Foreground="#44506B" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource PrimaryBrush}" Margin="10,0,0,0" FontWeight="SemiBold"/>
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.Resources>
        </TreeView>
      </Grid>
    </Border>
  </Grid>
</UserControl>
