<Window x:Class="SadrApp.Views.PrintSettingEditWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش تنظیم چاپ" Height="520" Width="560"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}" ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="130"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="نام تنظیم:" Style="{StaticResource H3}" VerticalAlignment="Center"/>
    <TextBox x:Name="TblName" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="6" FontSize="13"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="چیدمان:" Style="{StaticResource H3}" VerticalAlignment="Center"/>
    <ComboBox x:Name="CmbLayout" Grid.Row="1" Grid.Column="1" Margin="0,4" FontSize="13">
      <ComboBoxItem Content="کلاسیک رسمی"/>
      <ComboBoxItem Content="ساده و مدرن"/>
      <ComboBoxItem Content="کامپکت"/>
    </ComboBox>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="عنوان سفارشی:" Style="{StaticResource H3}" VerticalAlignment="Center"/>
    <TextBox x:Name="TblTitle" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="6" FontSize="13"
             ToolTip="خالی = عنوان نوع فاکتور (فاکتور فروش / خرید / پیش‌فاکتور)"/>

    <TextBlock Grid.Row="3" Grid.Column="0" Text="یادداشت پایین:" Style="{StaticResource H3}" VerticalAlignment="Center"/>
    <TextBox x:Name="TblFooter" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="6" FontSize="13"
             ToolTip="متن پایین صفحه چاپ‌شده"/>

    <CheckBox x:Name="ChkDiscount" Grid.Row="4" Grid.Column="1" Content="نمایش ستون اضافه/تخفیف در جدول کالا"
              IsChecked="True" Margin="0,8" FontSize="13"/>

    <TextBlock Grid.Row="5" Grid.Column="0" Text="لوگو:" Style="{StaticResource H3}" VerticalAlignment="Top" Margin="0,10,0,0"/>
    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
      <Border Background="White" BorderBrush="#C9D2E3" BorderThickness="1" CornerRadius="6"
              Width="110" Height="80" Padding="4">
        <Image x:Name="LogoPreview" Stretch="Uniform"/>
      </Border>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
        <Button x:Name="BtnPickLogo" Content="📁 انتخاب تصویر…" Style="{StaticResource GhostBtn}" Margin="0,0,0,6"/>
        <Button x:Name="BtnClearLogo" Content="✖ حذف لوگو" Style="{StaticResource GhostBtn}"/>
        <TextBlock Text="PNG یا JPG، حداکثر ۲MB" Foreground="#8A94A8" FontSize="10.5" Margin="0,6,0,0"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button x:Name="BtnSave" Content="💾 ذخیره" Style="{StaticResource PrimaryBtn}" MinWidth="100" Margin="0,0,8,0"/>
      <Button x:Name="BtnCancel" Content="انصراف" Style="{StaticResource GhostBtn}" MinWidth="80"/>
    </StackPanel>
  </Grid>
</Window>
