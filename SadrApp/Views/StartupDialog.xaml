<Window x:Class="SadrApp.Views.StartupDialog"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اتصال به پایگاه داده" Height="260" Width="480"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBgBrush}" ResizeMode="NoResize" WindowStyle="ToolWindow">
  <StackPanel Margin="18">
    <TextBlock Text="⚠️ اتصال به پایگاه داده برقرار نشد" Style="{StaticResource H1}" Margin="0,0,0,8"/>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#44506B" Margin="0,0,0,14"/>
    <TextBlock Text="می‌توانید تنظیمات اتصال را ویرایش کنید (فایل Connection.dat در کنار برنامه ذخیره می‌شود)."
               TextWrapping="Wrap" Foreground="#8A94A8" FontSize="12" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
      <Button x:Name="BtnSettings" Content="🔧 تنظیمات اتصال" Style="{StaticResource PrimaryBtn}" MinWidth="130" Margin="0,0,8,0"/>
      <Button x:Name="BtnExit" Content="خروج" Style="{StaticResource GhostBtn}"/>
    </StackPanel>
  </StackPanel>
</Window>
