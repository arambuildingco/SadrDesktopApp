<Window x:Class="SadrApp.Views.ConnectionSettingsWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات اتصال به پایگاه داده" Height="560" Width="620"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}" ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="اتصال به SQL Server" Style="{StaticResource H1}" Margin="0,0,0,12"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="نام سرور (SQL Server Engine)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ServerBox" Style="{StaticResource Input}"/>
            <TextBlock Text="نمونه: .\SQLExpress یا localhost یا 192.168.1.10,1433"
                       Foreground="#8A94A8" FontSize="11" Margin="0,4,0,0"/>

            <TextBlock Text="نام پایگاه داده" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DbBox" Style="{StaticResource Input}"/>

            <TextBlock Text="نوع احراز هویت" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AuthSql" Content="کاربر SQL Server (نام کاربری/رمز)" IsChecked="True" Margin="0,0,16,0"/>
              <RadioButton x:Name="AuthWindows" Content="Windows Authentication"/>
            </StackPanel>

            <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox" Style="{StaticResource Input}"/>

            <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PassBox" Style="{StaticResource FieldInput}" FontFamily="Consolas"/>

            <TextBlock Text="رشته اتصال نهایی (قابل ویرایش دستی)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="FinalBox" Style="{StaticResource Input}" FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <Button x:Name="BtnTest" Content="🔌 آزمایش اتصال" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" MinWidth="140"/>
            <TextBlock x:Name="TestResult" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button x:Name="BtnSave" Content="💾 ذخیره در Connection.dat" Style="{StaticResource PrimaryBtn}" MinWidth="170" Margin="0,0,8,0"/>
      <Button Content="انصراف" Style="{StaticResource GhostBtn}" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
