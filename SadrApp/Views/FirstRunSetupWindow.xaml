<Window x:Class="SadrApp.Views.FirstRunSetupWindow"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی اولیه سامانه" Height="430" Width="470"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource PageBgBrush}">
  <StackPanel Margin="22">
    <TextBlock Text="🛠 راه‌اندازی اولیه سامانه" Style="{StaticResource H1}" Margin="0,0,0,6"/>
    <TextBlock Text="پایگاه داده ساخته شد. حالا کاربر مدیر اصلی را تعریف کنید تا وارد سامانه شوید."
               TextWrapping="Wrap" Foreground="#44506B" FontSize="12" Margin="0,0,0,14"/>

    <TextBlock Text="نام کاربری مدیر" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="TxtUsername" Style="{StaticResource Input}" Padding="10,8" Text="admin"/>

    <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}"/>
    <PasswordBox x:Name="TxtPassword" FlowDirection="LeftToRight" Padding="10,8"
                 Background="White" BorderBrush="#C3D2F4" BorderThickness="1" FontSize="14"/>

    <TextBlock Text="تکرار رمز عبور" Style="{StaticResource FieldLabel}"/>
    <PasswordBox x:Name="TxtPassword2" FlowDirection="LeftToRight" Padding="10,8"
                 Background="White" BorderBrush="#C3D2F4" BorderThickness="1" FontSize="14"/>

    <TextBlock Text="ایمیل (اختیاری)" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="TxtEmail" Style="{StaticResource Input}" Padding="10,8"/>

    <TextBlock x:Name="ErrorText" Foreground="#D9534F" FontSize="12" TextWrapping="Wrap"
               Margin="0,10,0,0" HorizontalAlignment="Center" Text=" "/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
      <Button x:Name="BtnCreate" Content="✔ ایجاد کاربر مدیر" Style="{StaticResource PrimaryBtn}"
              MinWidth="150" Height="36"/>
      <Button x:Name="BtnExit" Content="خروج" Style="{StaticResource GhostBtn}"
              MinWidth="90" Height="36" Margin="8,0,0,0"/>
    </StackPanel>
  </StackPanel>
</Window>
