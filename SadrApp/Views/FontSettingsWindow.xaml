<Window x:Class="SadrApp.Views.FontSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات فونت" Height="620" Width="560"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}" ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="تنظیمات فونت" Style="{StaticResource H1}" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="برای هر بخش می‌توانید قلم و اندازهٔ جداگانه انتخاب کنید، یا با دکمهٔ بالا یک قلم برای همهٔ بخش‌ها بگذارید. تنظیمات برای کاربر جاری ذخیره می‌شود."
               Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <Border Grid.Row="2" Style="{StaticResource SectionCard}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>

        <!-- header row -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="بخش" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,6,6"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="قلم" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,6,6"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="اندازه" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,0,6"/>

        <!-- apply-all row: one family+size copied to every scope -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#EDF3FF" CornerRadius="6" Padding="8" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="همهٔ بخش‌ها با هم" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="CmbAllFamily" Style="{StaticResource Combo}" Margin="0,0,6,0"/>
            <TextBox Grid.Column="2" x:Name="NumAllSize" Style="{StaticResource Input}" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="⬇️ اعمال به همه" x:Name="BtnApplyAll" Style="{StaticResource GhostBtn}"/>
          </Grid>
        </Border>

        <!-- rows 2..6: one per scope -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="منوها" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbMenuFamily" Style="{StaticResource Combo}" Margin="0,0,6,6"/>
        <TextBox Grid.Row="2" Grid.Column="2" x:Name="NumMenuSize" Style="{StaticResource Input}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="تیتر فرم‌ها و صفحات" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbFormFamily" Style="{StaticResource Combo}" Margin="0,0,6,6"/>
        <TextBox Grid.Row="3" Grid.Column="2" x:Name="NumFormSize" Style="{StaticResource Input}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="برچسب فیلدها" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbLabelFamily" Style="{StaticResource Combo}" Margin="0,0,6,6"/>
        <TextBox Grid.Row="4" Grid.Column="2" x:Name="NumLabelSize" Style="{StaticResource Input}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="فیلدهای ورودی" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CmbInputFamily" Style="{StaticResource Combo}" Margin="0,0,6,6"/>
        <TextBox Grid.Row="5" Grid.Column="2" x:Name="NumInputSize" Style="{StaticResource Input}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="جدول‌ها و گریدها" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="CmbGridFamily" Style="{StaticResource Combo}" Margin="0,0,6,6"/>
        <TextBox Grid.Row="6" Grid.Column="2" x:Name="NumGridSize" Style="{StaticResource Input}" Margin="0,0,0,6"/>

        <!-- live preview -->
        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Background="#F7F9FD"
                BorderBrush="#D9E1EF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="پیش‌نمایش" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}" x:Name="PvForm"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="نام:" x:Name="PvLabel" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox Text="نمونه ورودی" x:Name="PvInput" Width="160" Background="White"/>
              <Button Content="ثبت" x:Name="PvBtn" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="منو: پرونده‌ها | فاکتورها | سیستم" x:Name="PvMenu" Margin="0,8,0,0"/>
            <Border Background="White" CornerRadius="4" Padding="6" Margin="0,8,0,0" BorderBrush="#D9E1EF" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="شرح" FontWeight="SemiBold" x:Name="PvGridHead"/>
                <TextBlock Text="فاکتور شمارهٔ ۱۲۳ — مشتری: شرکت الف" x:Name="PvGrid"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button Content="💾 ذخیره و اعمال" Style="{StaticResource PrimaryBtn}" x:Name="BtnSave" MinWidth="120"/>
      <Button Content="↩️ بازگردانی پیش‌فرض" Style="{StaticResource GhostBtn}" x:Name="BtnReset" Margin="8,0,0,0"/>
      <Button Content="انصراف" Style="{StaticResource GhostBtn}" x:Name="BtnCancel" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
